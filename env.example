# Copy to .env and fill in real values. Never commit .env.

# --- Database (Phase 2: Neon Postgres) ---
# Pooled connection string (hostname contains "-pooler") — used by the app
DATABASE_URL=
# Direct connection string (same, without "-pooler") — used by migrations
DIRECT_DATABASE_URL=

# --- Auth (Phase 3) ---
# Long random string for signing session tokens: `openssl rand -base64 32`
AUTH_SECRET=
# The one email address allowed to be admin
ADMIN_EMAIL=

# --- Brevo email OTP (Phase 3) ---
BREVO_API_KEY=
# Verified sender email in Brevo
BREVO_SENDER_EMAIL=

# --- Cloudinary images (Phase 4/8) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- AI support agent (Google Gemini — free tier, no card) ---
# aistudio.google.com/apikey → Create API key. Without it, chat shows a "coming soon" note.
GEMINI_API_KEY=
# Optional: override the model (default gemini-2.5-flash)
GEMINI_MODEL=

# --- Razorpay test mode (Phase 6) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
